---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main
        class="min-h-screen bg-gradient-to-br from-background to-line-alt py-8 px-4"
    >
        <div class="max-w-2xl mx-auto">
            <!-- Header -->
            <div class="text-center mb-8">
                <h1
                    class="text-4xl font-bold text-text-color mb-2 font-heading"
                >
                    GPS Accuracy Test
                </h1>
                <p class="text-text-color-alt font-body">
                    ทดสอบและบันทึกความแม่นยำของ GPS
                </p>
                <div class="mt-4 flex flex-wrap justify-center gap-3">
                  <a href="/data" class="inline-flex items-center bg-primary hover:bg-accent text-white px-4 py-2 rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl font-body">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    ดูข้อมูลที่บันทึกไว้
                  </a>
                  <a href="/stats" class="inline-flex items-center bg-secondary hover:bg-accent text-white px-4 py-2 rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl font-body">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    สถิติ
                  </a>
                  <a href="/test-api" class="inline-flex items-center bg-line hover:bg-line-alt text-text-color px-4 py-2 rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl font-body">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    ทดสอบ API
                  </a>
                </div>
              </div>
            </div>

            <!-- GPS Status Card -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
                <h2
                    class="text-xl font-semibold text-text-color mb-4 flex items-center font-heading"
                >
                    <svg
                        class="w-6 h-6 mr-2 text-primary"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        ></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    ข้อมูล GPS
                </h2>
                <div id="gps-status" class="text-center py-4">
                    <div class="animate-pulse">
                        <div
                            class="inline-block w-8 h-8 border-4 border-blue-200 border-t-blue-500 rounded-full animate-spin"
                        >
                        </div>
                        <p class="mt-2 text-text-color-alt font-body">
                            กำลังดึงข้อมูล GPS...
                        </p>
                    </div>
                </div>
                <div
                    id="gps-data"
                    class="hidden grid grid-cols-1 md:grid-cols-3 gap-4"
                >
                    <div class="bg-line rounded-lg p-4">
                        <p class="text-sm text-text-color-alt font-body">
                            ละติจูด
                        </p>
                        <p
                            id="latitude"
                            class="text-lg font-semibold text-primary font-heading"
                        >
                            -
                        </p>
                    </div>
                    <div class="bg-line rounded-lg p-4">
                        <p class="text-sm text-text-color-alt font-body">
                            ลองจิจูด
                        </p>
                        <p
                            id="longitude"
                            class="text-lg font-semibold text-accent font-heading"
                        >
                            -
                        </p>
                    </div>
                    <div class="bg-line rounded-lg p-4">
                        <p class="text-sm text-text-color-alt font-body">
                            ความแม่นยำ
                        </p>
                        <p
                            id="accuracy"
                            class="text-lg font-semibold text-secondary font-heading"
                        >
                            -
                        </p>
                    </div>
                </div>
                <button
                    id="refresh-gps"
                    class="hidden mt-4 w-full bg-primary hover:bg-accent text-white py-2 px-4 rounded-lg transition-colors font-body"
                >
                    รีเฟรช GPS
                </button>
            </div>

            <!-- Form Card -->
            <div class="bg-white rounded-xl shadow-lg p-6">
                <h2
                    class="text-xl font-semibold text-text-color mb-6 flex items-center font-heading"
                >
                    <svg
                        class="w-6 h-6 mr-2 text-accent"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                        ></path>
                    </svg>
                    บันทึกข้อมูลการทดสอบ
                </h2>

                <form id="location-form" class="space-y-6">
                    <div>
                        <label
                            for="device_model"
                            class="block text-sm font-medium text-text-color mb-2 font-body"
                        >
                            รุ่นอุปกรณ์ <span class="text-secondary">*</span>
                        </label>
                        <input
                            type="text"
                            id="device_model"
                            name="device_model"
                            required
                            placeholder="เช่น iPhone 14 Pro, Samsung Galaxy S23"
                            class="w-full px-4 py-3 border border-line rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-body"
                        />
                    </div>

                    <div>
                        <label
                            for="location"
                            class="block text-sm font-medium text-text-color mb-2 font-body"
                        >
                            สถานที่ทดสอบ <span class="text-secondary">*</span>
                        </label>
                        <input
                            type="text"
                            id="location"
                            name="location"
                            required
                            placeholder="เช่น อาคาร 6 ชั้น 3, ห้องประชุม A, กลางแจ้ง"
                            class="w-full px-4 py-3 border border-line rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent transition-all font-body"
                        />
                    </div>

                    <div class="bg-line border border-line-alt rounded-lg p-4">
                        <div class="flex items-start">
                            <svg
                                class="w-5 h-5 text-secondary mr-2 mt-0.5"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                                    clip-rule="evenodd"></path>
                            </svg>
                            <div>
                                <h3
                                    class="text-sm font-medium text-text-color font-heading"
                                >
                                    หมายเหตุ
                                </h3>
                                <p
                                    class="text-sm text-text-color-alt mt-1 font-body"
                                >
                                    ข้อมูล GPS จะถูกดึงอัตโนมัติ
                                    กรุณาอนุญาตการเข้าถึงตำแหน่งเมื่อเบราว์เซอร์ขอ
                                </p>
                            </div>
                        </div>
                    </div>

                    <button
                        type="submit"
                        id="submit-btn"
                        disabled
                        class="w-full bg-line text-white py-3 px-6 rounded-lg font-semibold transition-all disabled:cursor-not-allowed font-body"
                    >
                        <span id="submit-text">รอข้อมูล GPS...</span>
                        <svg
                            id="loading-spinner"
                            class="hidden w-5 h-5 ml-2 animate-spin"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                            ></path>
                        </svg>
                    </button>
                </form>
            </div>

            <!-- Error Message -->
            <div
                id="error-message"
                class="hidden mt-6 bg-line border border-secondary text-secondary px-4 py-3 rounded-lg"
            >
                <div class="flex items-center">
                    <svg
                        class="w-5 h-5 mr-2"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                            clip-rule="evenodd"></path>
                    </svg>
                    <span id="error-text" class="font-body"
                        >เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง</span
                    >
                </div>
            </div>
        </div>
    </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    let currentGPSData = null;

    function updateGPSDisplay(lat, lon, accuracy) {
      document.getElementById('latitude').textContent = lat.toFixed(6);
      document.getElementById('longitude').textContent = lon.toFixed(6);
      document.getElementById('accuracy').textContent = `±${accuracy.toFixed(1)} เมตร`;
      
      document.getElementById('gps-status').classList.add('hidden');
      document.getElementById('gps-data').classList.remove('hidden');
      document.getElementById('refresh-gps').classList.remove('hidden');
      
      const submitBtn = document.getElementById('submit-btn');
      const submitText = document.getElementById('submit-text');
      const loadingSpinner = document.getElementById('loading-spinner');
      
      submitBtn.disabled = false;
      submitBtn.classList.remove('bg-line');
      submitBtn.classList.add('bg-accent', 'hover:bg-primary');
      submitText.textContent = 'บันทึกข้อมูล';
      loadingSpinner.classList.add('hidden');
    }

    function showGPSError(message) {
      const statusDiv = document.getElementById('gps-status');
      statusDiv.innerHTML = `
        <div class="text-center py-4">
          <svg class="w-12 h-12 text-secondary mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p class="text-secondary font-semibold font-heading">ไม่สามารถดึงข้อมูล GPS ได้</p>
          <p class="text-text-color-alt text-sm mt-1 font-body">${message}</p>
          <button onclick="getCurrentPosition()" class="mt-3 bg-primary hover:bg-accent text-white py-2 px-4 rounded-lg transition-colors font-body">
            ลองใหม่
          </button>
        </div>
      `;
    }

    function getCurrentPosition() {
      document.getElementById('gps-status').innerHTML = `
        <div class="animate-pulse">
          <div class="inline-block w-8 h-8 border-4 border-line border-t-primary rounded-full animate-spin"></div>
          <p class="mt-2 text-text-color-alt font-body">กำลังดึงข้อมูล GPS...</p>
        </div>
      `;

      navigator.geolocation.getCurrentPosition(
        function (position) {
          const lat = position.coords.latitude;
          const lon = position.coords.longitude;
          const accuracy = position.coords.accuracy;

          currentGPSData = { lat, lon, accuracy };
          updateGPSDisplay(lat, lon, accuracy);

          console.log(`Latitude: ${lat}`);
          console.log(`Longitude: ${lon}`);
          console.log(`Accuracy: ±${accuracy} meters`);
        },
        function (error) {
          let message = "ไม่ทราบสาเหตุ";
          switch(error.code) {
            case error.PERMISSION_DENIED:
              message = "ผู้ใช้ไม่อนุญาตการเข้าถึงตำแหน่ง";
              break;
            case error.POSITION_UNAVAILABLE:
              message = "ไม่สามารถหาตำแหน่งได้";
              break;
            case error.TIMEOUT:
              message = "หมดเวลาในการค้นหาตำแหน่ง";
              break;
          }
          showGPSError(message);
          console.error("ไม่สามารถดึงตำแหน่งได้: ", error.message);
        },
        {
          enableHighAccuracy: true,
          timeout: 10000,
          maximumAge: 0,
        }
      );
    }

    function hideMessage(elementId) {
      setTimeout(() => {
        document.getElementById(elementId).classList.add('hidden');
      }, 5000);
    }

    // Initialize GPS on page load
    getCurrentPosition();

    // Refresh GPS button
    document.getElementById('refresh-gps').addEventListener('click', getCurrentPosition);

    // Form submission
    document.getElementById('location-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      if (!currentGPSData) {
        document.getElementById('error-text').textContent = 
          'ไม่พบข้อมูล GPS กรุณารอให้ระบบดึงข้อมูลก่อน';
        document.getElementById('error-message').classList.remove('hidden');
        hideMessage('error-message');
        return;
      }

      const submitBtn = document.getElementById('submit-btn');
      const submitText = document.getElementById('submit-text');
      const loadingSpinner = document.getElementById('loading-spinner');
      
      // Show loading state
      submitBtn.disabled = true;
      submitBtn.classList.remove('bg-accent', 'hover:bg-primary');
      submitBtn.classList.add('bg-line');
      submitText.textContent = 'กำลังบันทึก...';
      loadingSpinner.classList.remove('hidden');
      loadingSpinner.style.display = 'inline-block';

      const formData = new FormData(e.target);
      const data = {
        device_model: formData.get('device_model'),
        latitude: currentGPSData.lat,
        longitude: currentGPSData.lon,
        accuracy: currentGPSData.accuracy,
        location: formData.get('location')
      };

      try {
        const response = await fetch('/api/save-location', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data)
        });

        // Check if response is ok before parsing JSON
        if (!response.ok) {
          throw new Error(`HTTP Error: ${response.status} ${response.statusText}`);
        }

        // Check if response is JSON
        const contentType = response.headers.get("content-type");
        if (!contentType || !contentType.includes("application/json")) {
          throw new Error("Server did not return JSON response");
        }

        const result = await response.json();

        // Store test data for thank you page
        const testData = {
          device: data.device_model,
          accuracy: data.accuracy,
          location: data.location
        };
        localStorage.setItem('lastGPSTest', JSON.stringify(testData));
        
        // Redirect to thank you page with query parameters
        const params = new URLSearchParams({
          device: data.device_model,
          accuracy: data.accuracy.toFixed(1),
          location: data.location
        });
        window.location.href = `/thank-you?${params.toString()}`;
      } catch (error) {
        console.error('Error:', error);
        document.getElementById('error-text').textContent = error.message;
        document.getElementById('error-message').classList.remove('hidden');
        hideMessage('error-message');
      } finally {
        // Reset button state
        submitBtn.disabled = false;
        submitBtn.classList.remove('bg-line');
        submitBtn.classList.add('bg-accent', 'hover:bg-primary');
        submitText.textContent = 'บันทึกข้อมูล';
        loadingSpinner.classList.add('hidden');
        loadingSpinner.style.display = 'none';
      }
    });

    // Make getCurrentPosition global for onclick handlers
    window.getCurrentPosition = getCurrentPosition;
  });
</script>
