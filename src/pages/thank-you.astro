                                    id="last-device"
                                >
                                    -
                                </p>
                                <p
                                    class="text-xs text-text-color-alt font-body"
                                >
                                    อุปกรณ์
                                </p>
                            </div>
                            <div class="text-center">
                                <p
                                    class="text-lg font-semibold text-secondary font-heading"
                                    id="last-accuracy"
                                >
                                    -
                                </p>
                                <p
                                    class="text-xs text-text-color-alt font-body"
                                >
                                    ความแม่นยำ
                                </p>
                            </div>
                            <div class="text-center">
                                <p
                                    class="text-lg font-semibold text-accent font-heading"
                                    id="last-location"
                                >
                                    -
                                </p>
                                <p
                                    class="text-xs text-text-color-alt font-body"
                                >
                                    สถานที่
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="space-y-4">
                <div class="text-center">
                    <h3
                        class="text-lg font-semibold text-text-color mb-4 font-heading"
                    >
                        คุณต้องการทำอะไรต่อ?
