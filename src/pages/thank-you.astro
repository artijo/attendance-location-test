        <div class="max-w-2xl mx-auto">
            <!-- Success Animation -->
            <div class="text-center mb-8">
                <div
                    class="inline-flex items-center justify-center w-24 h-24 bg-accent rounded-full mb-6 animate-bounce"
                >
                    <svg
                        class="w-12 h-12 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                </div>
                <h1
                    class="text-4xl font-bold text-text-color mb-4 font-heading"
                >
                    ขอบคุณครับ!
                </h1>
                <p class="text-xl text-text-color-alt font-body">
                    ข้อมูลการทดสอบ GPS ของคุณถูกบันทึกเรียบร้อยแล้ว
                </p>
            </div>

            <!-- Thank you message -->
            <div class="bg-white rounded-xl shadow-lg p-8 mb-6">
                <div class="text-center">
                    <h2
                        class="text-2xl font-semibold text-text-color mb-4 font-heading"
                    >
                        การมีส่วนร่วมของคุณมีค่ามาก
                    </h2>
                    <p
                        class="text-text-color-alt mb-6 font-body leading-relaxed"
                    >
                        ข้อมูลที่คุณให้มาจะช่วยให้เราเข้าใจความแม่นยำของ GPS
                        ในสถานการณ์และสถานที่ต่างๆ ได้ดีขึ้น
                        ข้อมูลเหล่านี้จะเป็นประโยชน์สำหรับการพัฒนาเทคโนโลยีตำแหน่งในอนาคต
                    </p>

                    <!-- Stats box -->
                    <div class="bg-line rounded-lg p-4 mb-6">
                        <p class="text-sm text-text-color-alt font-body">
                            ข้อมูลล่าสุดของคุณ
                        </p>
                        <div
                            id="test-summary"
                            class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-2"
                        >
