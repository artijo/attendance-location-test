---
import Layout from "../layouts/Layout.astro";
---

<Layout title="API Test - GPS Accuracy Test">
  <main class="min-h-screen bg-gradient-to-br from-background to-line-alt py-8 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-text-color mb-2 font-heading">API Test</h1>
        <p class="text-text-color-alt font-body">ทดสอบการทำงานของ API endpoints</p>
      </div>

      <!-- Test Results -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Test get-locations API -->
        <div class="bg-white rounded-xl shadow-lg p-6">
          <h2 class="text-xl font-semibold text-text-color mb-4 font-heading">Test GET /api/get-locations</h2>
          <button id="test-get" class="bg-primary hover:bg-accent text-white px-4 py-2 rounded-lg font-body mb-4">
            ทดสอบ GET API
          </button>
          <div id="get-result" class="bg-line rounded-lg p-4 text-sm font-mono overflow-auto max-h-96">
            คลิกปุ่มเพื่อทดสอบ
          </div>
        </div>

        <!-- Test save-location API -->
        <div class="bg-white rounded-xl shadow-lg p-6">
          <h2 class="text-xl font-semibold text-text-color mb-4 font-heading">Test POST /api/save-location</h2>
          <button id="test-post" class="bg-secondary hover:bg-accent text-white px-4 py-2 rounded-lg font-body mb-4">
            ทดสอบ POST API
          </button>
          <div id="post-result" class="bg-line rounded-lg p-4 text-sm font-mono overflow-auto max-h-96">
            คลิกปุ่มเพื่อทดสอบ
          </div>
        </div>
      </div>

      <!-- Database Connection Test -->
      <div class="mt-6 bg-white rounded-xl shadow-lg p-6">
        <h2 class="text-xl font-semibold text-text-color mb-4 font-heading">Database Connection</h2>
        <button id="test-db" class="bg-accent hover:bg-primary text-white px-4 py-2 rounded-lg font-body mb-4">
          ทดสอบการเชื่อมต่อฐานข้อมูล
        </button>
        <div id="db-result" class="bg-line rounded-lg p-4 text-sm font-mono overflow-auto max-h-96">
          คลิกปุ่มเพื่อทดสอบ
        </div>
      </div>

      <!-- Navigation -->
      <div class="text-center mt-8">
        <a href="/" class="inline-flex items-center bg-primary hover:bg-accent text-white px-4 py-2 rounded-lg transition-colors font-body">
          กลับหน้าหลัก
        </a>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    
    function displayResult(elementId, result, isSuccess = true) {
      const element = document.getElementById(elementId);
      element.innerHTML = JSON.stringify(result, null, 2);
      element.className = `rounded-lg p-4 text-sm font-mono overflow-auto max-h-96 ${
        isSuccess ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800'
      }`;
    }

    // Test GET API
    document.getElementById('test-get').addEventListener('click', async function() {
      try {
        document.getElementById('get-result').textContent = 'กำลังทดสอบ...';
        
        const response = await fetch('/api/get-locations?limit=5');
        const result = {
          status: response.status,
          statusText: response.statusText,
          headers: Object.fromEntries(response.headers.entries()),
          contentType: response.headers.get('content-type')
        };

        if (response.ok) {
          const data = await response.json();
          result.data = data;
          displayResult('get-result', result, true);
        } else {
          const errorText = await response.text();
          result.error = errorText;
          displayResult('get-result', result, false);
        }
      } catch (error) {
        displayResult('get-result', { error: error.message }, false);
      }
    });

    // Test POST API
    document.getElementById('test-post').addEventListener('click', async function() {
      try {
        document.getElementById('post-result').textContent = 'กำลังทดสอบ...';
        
        const testData = {
          device_model: 'Test Device',
          latitude: 13.7563,
          longitude: 100.5018,
          accuracy: 5.0,
          location: 'Test Location'
        };

        const response = await fetch('/api/save-location', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(testData)
        });

        const result = {
          status: response.status,
          statusText: response.statusText,
          headers: Object.fromEntries(response.headers.entries()),
          contentType: response.headers.get('content-type'),
          requestData: testData
        };

        if (response.ok) {
          const data = await response.json();
          result.data = data;
          displayResult('post-result', result, true);
        } else {
          const errorText = await response.text();
          result.error = errorText;
          displayResult('post-result', result, false);
        }
      } catch (error) {
        displayResult('post-result', { error: error.message }, false);
      }
    });

    // Test Database Connection
    document.getElementById('test-db').addEventListener('click', async function() {
      try {
        document.getElementById('db-result').textContent = 'กำลังทดสอบ...';
        
        // Test with a simple count query via GET API
        const response = await fetch('/api/get-locations?limit=1');
        const result = {
          status: response.status,
          statusText: response.statusText,
          timestamp: new Date().toISOString()
        };

        if (response.ok) {
          const data = await response.json();
          result.connectionStatus = 'SUCCESS';
          result.recordCount = data.total || 0;
          result.data = data;
          displayResult('db-result', result, true);
        } else {
          result.connectionStatus = 'FAILED';
          const errorText = await response.text();
          result.error = errorText;
          displayResult('db-result', result, false);
        }
      } catch (error) {
        displayResult('db-result', { 
          connectionStatus: 'ERROR',
          error: error.message,
          timestamp: new Date().toISOString()
        }, false);
      }
    });

  });
</script>