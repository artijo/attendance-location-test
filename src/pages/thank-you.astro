            </div>

            <!-- Footer message -->
            <div class="text-center mt-8 p-4 bg-line rounded-lg">
                <p class="text-sm text-text-color-alt font-body">
                    <svg
                        class="w-4 h-4 inline mr-1"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"
                            clip-rule="evenodd"></path>
                    </svg>
                    ขอบคุณที่ช่วยพัฒนาเทคโนโลยี GPS ให้ดีขึ้น
                </p>
            </div>
        </div>
    </main>
</Layout>

<script>
    // Get data from URL parameters or localStorage
    function getTestSummary() {
        const urlParams = new URLSearchParams(window.location.search);

        // Try to get from URL parameters first
        const device = urlParams.get("device");
        const accuracy = urlParams.get("accuracy");
        const location = urlParams.get("location");

        if (device && accuracy && location) {
            return { device, accuracy, location };
        }

        // Fallback to localStorage
        const lastTest = localStorage.getItem("lastGPSTest");
        if (lastTest) {
            try {
                return JSON.parse(lastTest);
            } catch (e) {
                console.error("Error parsing last test data:", e);
            }
        }

        return null;
    }

    function displayTestSummary() {
        const summary = getTestSummary();

        if (summary) {
            document.getElementById("last-device").textContent =
                summary.device || "-";
            document.getElementById("last-accuracy").textContent =
                summary.accuracy
                    ? `±${parseFloat(summary.accuracy).toFixed(1)} ม.`
                    : "-";
            document.getElementById("last-location").textContent =
                summary.location || "-";
        }
    }

    // Auto redirect after 30 seconds (optional)
    function autoRedirect() {
        setTimeout(() => {
            const userChoice = confirm("ต้องการทดสอบอีกครั้งหรือไม่?");
            if (userChoice) {
                window.location.href = "/";
            } else {
                window.location.href = "/data";
            }
        }, 30000); // 30 seconds
    }

    // Initialize
    displayTestSummary();
    // autoRedirect(); // Uncomment if you want auto redirect
</script>
